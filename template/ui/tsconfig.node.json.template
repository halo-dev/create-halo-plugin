{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": [
{{#if (eq uiTool "vite")}}
    "vite.config.*",
{{else}}
    "rsbuild.config.*",
{{/if}}
    "vitest.config.*",
    "eslint.config.*"
  ],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"]
  }
}
